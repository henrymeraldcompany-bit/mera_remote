{
  "name": "@mera/windows-agent",
  "version": "1.0.0",
  "description": "MERA Remote Management - Client Agent for Windows Laptops",
  "main": "dist/index.js",
  "bin": {
    "mera-agent": "dist/index.js"
  },
  "scripts": {
    "build": "node ../scripts/build-windows-agent.js",
    "start": "node dist/index.js",
    "pair": "node dist/index.js --pair",
    "status": "node dist/index.js --status",
    "unpair": "node dist/index.js --unpair",
    "dev": "node --experimental-strip-types src/index.ts",
    "install-service": "node dist/service-installer.js install",
    "uninstall-service": "node dist/service-installer.js uninstall"
  },
  "dependencies": {
    "@mera/shared": "*",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.5"
  }
}
